---
/**
 * @file Site Footer - Matches Header Style
 * @module SiteFooter
 */
import { getVisitorInfo } from '../utils/locationCheck';
import { execSync } from 'child_process';

const info = await getVisitorInfo();
const isLocal = info.isLocal;

const utm = (content: string) => `?utm_source=lakeozarkdisciples&utm_medium=footer&utm_campaign=nav&utm_content=${content}`;

let commitShort = '';
let commitFull = '';
let commitDate = '';
let commitMessage = '';

try {
  commitShort = execSync('git rev-parse --short HEAD').toString().trim();
  commitFull = execSync('git rev-parse HEAD').toString().trim();
  commitDate = execSync('git log -1 --format=%cd --date=format:"%b %d, %Y"').toString().trim();
  commitMessage = execSync('git log -1 --format=%s').toString().trim();
} catch (_) {}
---

<footer class="site-footer" role="contentinfo">
  <!-- Main Footer Content -->
  <div class="footer-main">
    <div class="footer-grid">
      
      <!-- Column 1: Brand & Contact -->
      <div class="footer-col footer-brand-col">
        <a href="/" class="footer-logo">
          <img 
            src="https://usercontent.donorkit.io/clients/LOCC/LOCC-header%20(1).png" 
            alt="Lake Ozark Christian Church" 
            width="160"
            height="48"
            loading="lazy"
          />
        </a>
        
        <p class="footer-tagline">
          A community of faith dedicated to sharing the Gospel of Jesus Christ.
        </p>

        <div class="footer-contact-info">
          <a href="tel:573-365-3366" class="footer-contact-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            (573) 365-3366
          </a>
          <a href="mailto:office@lakeozarkdisciples.org" class="footer-contact-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            office@lakeozarkdisciples.org
          </a>
        </div>

        <div class="footer-social">
          <a href="https://facebook.com/LakeOzarkChristianChurch" data-external="true" aria-label="Facebook">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
            </svg>
          </a>
          <a href="https://youtube.com/@lakeozarkchristianchurch" data-external="true" aria-label="YouTube">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Location -->
      <div class="footer-col">
        <h3 class="footer-heading">Location</h3>
        <address class="footer-address">
          <div class="footer-address-block">
            <p class="footer-address-label">Visit us</p>
            <p>1560 Bagnell Dam Blvd.</p>
            <p>Lake Ozark, MO 65049</p>
          </div>
          <div class="footer-address-block">
            <p class="footer-address-label">Mailing address</p>
            <p>P.O. Box 194</p>
            <p>Lake Ozark, MO 65049</p>
          </div>
        </address>
        <a 
          href="https://www.google.com/maps/dir//Lake+Ozark+Christian+Church" 
          data-external="true"
          class="footer-directions-link"
        >
          Get directions →
        </a>
      </div>

      <!-- Column 3: Worship -->
      <div class="footer-col">
        <h3 class="footer-heading">Worship</h3>
        <ul class="footer-nav">
          <li><a href={`/worship${utm('services')}`}>Sunday services</a></li>
          <li><a href={`/live${utm('live')}`}>Watch live</a></li>
          <li><a href={`/videos${utm('videos')}`}>Past services</a></li>
          <li><a href={`/giving${utm('giving')}`}>Give</a></li>
          <li><a href={`/calendar${utm('calendar')}`}>Calendar</a></li>
        </ul>
      </div>

      <!-- Column 4: About -->
      <div class="footer-col">
        <h3 class="footer-heading">About</h3>
        <ul class="footer-nav">
          <li><a href={`/about${utm('about')}`}>Our church</a></li>
          <li><a href={`/staff${utm('staff')}`}>Leadership</a></li>
          <li><a href={`/children-youth${utm('programs')}`}>Programs</a></li>
          <li><a href={`/weddings${utm('weddings')}`}>Weddings</a></li>
          <li><a href={`/blog${utm('blog')}`}>News</a></li>
          <li><a href={`/chimes${utm('newsletter')}`}>Newsletter</a></li>
        </ul>
      </div>

      <!-- Column 5: Resources -->
      <div class="footer-col">
        <h3 class="footer-heading">Resources</h3>
        <ul class="footer-nav">
          <li><a href="https://shelterinastorm.org" data-external="true">Shelter in a Storm</a></li>
          <li><a href={`/report${utm('report')}`}>Report an issue</a></li>
          <li><a href={`/giving${utm('giving-footer')}`}>Online giving</a></li>
        </ul>
      </div>

    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="footer-bottom">
    <div class="footer-bottom-inner">

      <!-- Left: copyright + org info -->
      <div class="fbb-left">
        <p class="fbb-copyright">© {new Date().getFullYear()} Lake Ozark Christian Church, Inc.</p>
        <p class="fbb-ein">501(c)(3) · EIN 43-1193150</p>
      </div>

      <!-- Center: legal links -->
      <div class="fbb-center">
        <a href={`/legal/terms${utm('terms')}`} class="fbb-link">Terms</a>
        <span class="fbb-dot" aria-hidden="true">·</span>
        <a href={`/legal/privacy${utm('privacy')}`} class="fbb-link">Privacy</a>
        <span class="fbb-dot" aria-hidden="true">·</span>
        <a href={`/legal/refunds${utm('refunds')}`} class="fbb-link">Refunds</a>
        <span class="fbb-dot" aria-hidden="true">·</span>
        <button onclick="window.showCookieSettings && window.showCookieSettings()" class="fbb-link fbb-privacy-btn">
          <!-- Official California CPRA "Your Privacy Choices" opt-out icon -->
          <svg width="24" height="11" viewBox="0 0 30 14" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="fbb-privacy-icon">
            <path fill-rule="evenodd" clip-rule="evenodd" fill="#FFFFFF" d="M7.4,12.8h6.8l3.1-11.6H7.4C4.2,1.2,1.6,3.8,1.6,7S4.2,12.8,7.4,12.8z"/>
            <path fill-rule="evenodd" clip-rule="evenodd" fill="#0066FF" d="M22.6,0H7.4c-3.9,0-7,3.1-7,7s3.1,7,7,7h15.2c3.9,0,7-3.1,7-7S26.4,0,22.6,0z M1.6,7c0-3.2,2.6-5.8,5.8-5.8h9.9l-3.1,11.6H7.4C4.2,12.8,1.6,10.2,1.6,7z"/>
            <path fill="#FFFFFF" d="M24.6,4c0.2,0.2,0.2,0.6,0,0.8L22.5,7l2.2,2.2c0.2,0.2,0.2,0.6,0,0.8c-0.2,0.2-0.6,0.2-0.8,0l-2.2-2.2L19.5,10c-0.2,0.2-0.6,0.2-0.8,0c-0.2-0.2-0.2-0.6,0-0.8L20.8,7l-2.2-2.2c-0.2-0.2-0.2-0.6,0-0.8c0.2-0.2,0.6-0.2,0.8,0l2.2,2.2L23.8,4C24,3.8,24.4,3.8,24.6,4z"/>
            <path fill="#0066FF" d="M12.7,4.1c0.2,0.2,0.3,0.6,0.1,0.8L8.6,9.8C8.5,9.9,8.4,10,8.3,10c-0.2,0.1-0.5,0.1-0.7-0.1L5.4,7.7c-0.2-0.2-0.2-0.6,0-0.8c0.2-0.2,0.6-0.2,0.8,0L8,8.6l3.8-4.5C12,3.9,12.4,3.9,12.7,4.1z"/>
          </svg>
          Privacy Choices
        </button>
      </div>

      <!-- Right: credit + build badge -->
      <div class="fbb-right">
        <span class="fbb-credit">Designed by <a href="https://donorkit.io" data-external="true" class="fbb-credit-link">DonorKit, Inc</a></span>
        {commitShort && (
          <a
            href={`https://github.com/InactiveBen/Lake-Ozark/commit/${commitFull}`}
            data-external="true"
            class="footer-build-badge"
          >
            <span class="footer-build-label">build</span>
            <span class="footer-build-hash">{commitShort}</span>
            <span class="footer-build-tooltip">
              <span class="footer-build-tooltip-row">
                <span class="footer-build-tooltip-key">commit</span>
                <span class="footer-build-tooltip-val">{commitFull.slice(0, 12)}</span>
              </span>
              <span class="footer-build-tooltip-row">
                <span class="footer-build-tooltip-key">date</span>
                <span class="footer-build-tooltip-val">{commitDate}</span>
              </span>
              <span class="footer-build-tooltip-row">
                <span class="footer-build-tooltip-key">msg</span>
                <span class="footer-build-tooltip-val footer-build-tooltip-msg">{commitMessage}</span>
              </span>
            </span>
          </a>
        )}
