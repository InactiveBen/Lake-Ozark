---
/**
 * Weather Banner Component (Dialog Style)
 * ACTIVE CANCELLATION: Sunday January 25, 2026
 * Expires: January 28, 2026
 */
interface Props {
  messageId?: string;
  expiresAt?: string;
}

const { messageId = 'cancel-jan-25-2026', expiresAt = '2026-01-28T23:59:59' } = Astro.props;
const expirationDate = new Date(expiresAt);
const isExpired = new Date() > expirationDate;
---

{!isExpired && (
  <div 
    id={`weatherModal-${messageId}`}
    class="fixed inset-0 bg-black/70 z-[150] flex items-center justify-center p-6" 
    role="alertdialog" 
    aria-modal="true"
    aria-labelledby={`weatherTitle-${messageId}`}
    style="font-family: 'Albert Sans', system-ui, sans-serif;"
  >
    <div class="bg-white rounded-lg max-w-sm w-full p-6 modal-content">
      <p class="text-xs font-semibold text-red-600 uppercase tracking-wider mb-2">
        Service Canceled
      </p>
      <h2 id={`weatherTitle-${messageId}`} class="text-xl font-semibold text-gray-900 mb-4">
        Sunday, January 25
      </h2>
      <p class="text-sm text-gray-600 leading-relaxed mb-6">
        Due to inclement weather, our in-person worship service has been <strong class="text-gray-900">canceled</strong> for this Sunday. Please stay safe and we look forward to seeing you next week.
      </p>
      <button
        id={`closeWeather-${messageId}`}
        class="w-full bg-brand hover:bg-brand-dark text-white text-sm font-medium py-3 rounded-lg transition-colors"
      >
        Got it
      </button>
    </div>
  </div>
)}

<style>
  .modal-content {
    animation: fadeIn 0.2s ease-out;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>

<script define:vars={{ messageId, expirationDate: expirationDate.toISOString() }}>
  const modal = document.getElementById(`weatherModal-${messageId}`);
  const closeBtn = document.getElementById(`closeWeather-${messageId}`);
  
  function closeModal() {
    if (messageId) sessionStorage.setItem(`weather-${messageId}`, 'dismissed');
    modal?.remove();
  }

  // Check if already dismissed or expired
  if (messageId && sessionStorage.getItem(`weather-${messageId}`) === 'dismissed') {
    modal?.remove();
  }
  
  // Check if expired
  if (expirationDate && new Date() > new Date(expirationDate)) {
    modal?.remove();
  }

  // Event listeners
  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
</script>
