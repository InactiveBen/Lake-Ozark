---
export const prerender = false;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
  <title>LOZ Parking — Day Pass</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { height: 100%; }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: #f3f4f6;
      color: #111;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ── HEADER ── */
    .site-header {
      background: #111;
      padding: 0 28px;
      height: 58px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
    }

    .header-logo {
      display: flex;
      align-items: center;
      gap: 9px;
    }

    .logo-mark {
      width: 30px;
      height: 30px;
      background: #fff;
      border-radius: 5px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 800;
      color: #111;
      flex-shrink: 0;
    }

    .logo-name {
      font-size: 14px;
      font-weight: 700;
      color: #fff;
      letter-spacing: -0.2px;
    }

    .header-secure {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: #666;
    }

    /* ── LAYOUT ── */
    .page {
      flex: 1;
      display: flex;
      justify-content: center;
      padding: 36px 20px 56px;
    }

    .checkout {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 24px;
      width: 100%;
      max-width: 860px;
      align-items: start;
    }

    /* ── FORM SIDE ── */
    .form-side {}

    .section-block {
      background: #fff;
      border-radius: 8px;
      border: 1px solid #e5e7eb;
      margin-bottom: 16px;
      overflow: hidden;
    }

    .section-head {
      padding: 16px 20px;
      border-bottom: 1px solid #f0f0f0;
    }

    .section-title {
      font-size: 14px;
      font-weight: 700;
      color: #111;
      letter-spacing: -0.1px;
    }

    .section-body {
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .field label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: #6b7280;
      margin-bottom: 6px;
      letter-spacing: 0.2px;
    }

    input[type="text"],
    input[type="email"],
    select {
      width: 100%;
      height: 46px;
      padding: 0 14px;
      border: 1.5px solid #d1d5db;
      border-radius: 6px;
      font-size: 16px;
      font-family: inherit;
      color: #111;
      background: #fff;
      outline: none;
      -webkit-appearance: none;
      transition: border-color 0.15s, box-shadow 0.15s;
      -webkit-tap-highlight-color: transparent;
    }

    input:focus, select:focus {
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .plate-input {
      height: 62px !important;
      font-size: 28px !important;
      font-weight: 800 !important;
      letter-spacing: 8px !important;
      text-transform: uppercase !important;
      text-align: center !important;
    }

    .plate-input::placeholder {
      font-size: 13px;
      font-weight: 400;
      letter-spacing: 3px;
      color: #d1d5db;
    }

    .field-row {
      display: grid;
      grid-template-columns: 82px 1fr;
      gap: 10px;
    }

    /* ── RULES ── */
    .rules-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      background: none;
      border: none;
      padding: 16px 20px;
      cursor: pointer;
      font-family: inherit;
      -webkit-tap-highlight-color: transparent;
      border-bottom: 1px solid transparent;
      transition: border-color 0.15s;
    }

    .rules-toggle.open { border-bottom-color: #f0f0f0; }

    .rules-toggle-left {
      font-size: 14px;
      font-weight: 700;
      color: #111;
    }

    .rules-toggle-right {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 13px;
      color: #2563eb;
      font-weight: 500;
    }

    .chevron { transition: transform 0.2s; }
    .rules-toggle.open .chevron { transform: rotate(180deg); }

    .rules-list {
      list-style: none;
      display: none;
    }

    .rules-list.open { display: block; }

    .rules-list li {
      position: relative;
      padding: 10px 20px 10px 36px;
      font-size: 13px;
      color: #4b5563;
      line-height: 1.6;
      border-bottom: 1px solid #f3f4f6;
    }

    .rules-list li:last-child { border-bottom: none; }

    .rules-list li::before {
      content: '';
      position: absolute;
      left: 20px;
      top: 17px;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: #d1d5db;
    }

    .rules-list li strong { font-weight: 600; color: #111; }

    /* ── AGREE ── */
    .agree-row {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 16px 20px;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      border-top: 1px solid #f0f0f0;
    }

    .agree-row input[type="checkbox"] {
      width: 17px;
      height: 17px;
      flex-shrink: 0;
      accent-color: #2563eb;
      cursor: pointer;
    }

    .agree-row span {
      font-size: 13px;
      color: #374151;
      line-height: 1.4;
    }

    /* ── ORDER SUMMARY (right) ── */
    .summary-side {
      position: sticky;
      top: 24px;
    }

    .summary-card {
      background: #fff;
      border-radius: 8px;
      border: 1px solid #e5e7eb;
      overflow: hidden;
    }

    .summary-card-head {
      padding: 14px 20px;
      border-bottom: 1px solid #f0f0f0;
      font-size: 13px;
      font-weight: 700;
      color: #6b7280;
      text-transform: uppercase;
      letter-spacing: 0.6px;
    }

    .summary-item {
      padding: 18px 20px;
      border-bottom: 1px solid #f3f4f6;
    }

    .summary-item-name {
      font-size: 16px;
      font-weight: 700;
      color: #111;
      margin-bottom: 6px;
    }

    .summary-meta {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .summary-meta span {
      font-size: 12px;
      color: #9ca3af;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .summary-lines {
      padding: 14px 20px;
      border-bottom: 1px solid #f3f4f6;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .summary-line {
      display: flex;
      justify-content: space-between;
      font-size: 13px;
      color: #6b7280;
    }

    .summary-total {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 20px;
      border-bottom: 1px solid #f0f0f0;
    }

    .summary-total-label {
      font-size: 15px;
      font-weight: 700;
      color: #111;
    }

    .summary-total-price {
      font-size: 22px;
      font-weight: 800;
      color: #111;
      letter-spacing: -0.5px;
    }

    .summary-cta {
      padding: 16px 20px 20px;
    }

    /* ── ERROR ── */
    .error-msg {
      display: none;
      font-size: 13px;
      color: #b91c1c;
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 6px;
      padding: 10px 14px;
      margin-bottom: 12px;
    }

    .error-msg.show { display: block; }

    /* ── PAY BUTTON ── */
    .pay-btn {
      width: 100%;
      height: 50px;
      background: #2563eb;
      color: #fff;
      border: none;
      border-radius: 6px;
      font-size: 15px;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: background 0.1s;
      -webkit-tap-highlight-color: transparent;
      margin-bottom: 12px;
    }

    .pay-btn:hover { background: #1d4ed8; }
    .pay-btn:active { background: #1e40af; }
    .pay-btn:disabled { background: #93c5fd; cursor: not-allowed; }

    .spinner {
      display: none;
      width: 16px;
      height: 16px;
      border: 2px solid rgba(255,255,255,0.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.65s linear infinite;
    }

    @keyframes spin { to { transform: rotate(360deg); } }
    .pay-btn.loading .spinner { display: block; }
    .pay-btn.loading .btn-text { display: none; }

    .fine-print {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      font-size: 11px;
      color: #9ca3af;
    }

    /* ── MOBILE ── */
    @media (max-width: 700px) {
      body { background: #fff; }

      .page { padding: 0 0 48px; }

      .checkout {
        grid-template-columns: 1fr;
        gap: 0;
        max-width: 100%;
      }

      /* Summary moves to top on mobile */
      .summary-side {
        position: static;
        order: -1;
      }

      .summary-card {
        border-radius: 0;
        border-left: none;
        border-right: none;
        border-top: none;
      }

      .section-block {
        border-radius: 0;
        border-left: none;
        border-right: none;
        margin-bottom: 0;
        border-top: none;
      }

      .site-header { padding: 0 20px; }
    }
  </style>
</head>
<body>

  <header class="site-header">
    <div class="header-logo">
      <div class="logo-mark">P</div>
      <span class="logo-name">LOZ Parking</span>
    </div>
    <div class="header-secure">
      <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" stroke-width="2"/><path d="M7 11V7a5 5 0 0110 0v4" stroke-width="2" stroke-linecap="round"/></svg>
      Secure Checkout
    </div>
  </header>

  <div class="page">
    <div class="checkout">

      <!-- ── FORM SIDE ── -->
      <div class="form-side">

        <div class="section-block">
          <div class="section-head">
            <h2 class="section-title">Vehicle Information</h2>
          </div>
          <div class="section-body">
            <div class="field">
              <label for="plate">License Plate Number</label>
              <input type="text" id="plate" class="plate-input" placeholder="ABC 1234" maxlength="10"
                autocomplete="off" spellcheck="false" autocorrect="off" autocapitalize="characters" />
            </div>
            <div class="field field-row">
              <div>
                <label for="state">State</label>
                <select id="state">
                  <option value="MO" selected>MO</option>
                  <option value="AL">AL</option><option value="AK">AK</option><option value="AZ">AZ</option><option value="AR">AR</option><option value="CA">CA</option><option value="CO">CO</option><option value="CT">CT</option><option value="DE">DE</option><option value="FL">FL</option><option value="GA">GA</option><option value="HI">HI</option><option value="ID">ID</option><option value="IL">IL</option><option value="IN">IN</option><option value="IA">IA</option><option value="KS">KS</option><option value="KY">KY</option><option value="LA">LA</option><option value="ME">ME</option><option value="MD">MD</option><option value="MA">MA</option><option value="MI">MI</option><option value="MN">MN</option><option value="MS">MS</option><option value="MT">MT</option><option value="NE">NE</option><option value="NV">NV</option><option value="NH">NH</option><option value="NJ">NJ</option><option value="NM">NM</option><option value="NY">NY</option><option value="NC">NC</option><option value="ND">ND</option><option value="OH">OH</option><option value="OK">OK</option><option value="OR">OR</option><option value="PA">PA</option><option value="RI">RI</option><option value="SC">SC</option><option value="SD">SD</option><option value="TN">TN</option><option value="TX">TX</option><option value="UT">UT</option><option value="VT">VT</option><option value="VA">VA</option><option value="WA">WA</option><option value="WV">WV</option><option value="WI">WI</option><option value="WY">WY</option>
                </select>
              </div>
              <div>
                <label for="email">Email for Receipt</label>
                <input type="email" id="email" placeholder="you@example.com" autocomplete="email" />
              </div>
            </div>
            <div class="field field-row">
              <div>
                <label for="vehicle-color">Color</label>
                <select id="vehicle-color">
                  <option value="">Select…</option>
                  <option>White</option>
                  <option>Black</option>
                  <option>Silver / Gray</option>
                  <option>Red</option>
                  <option>Blue</option>
                  <option>Green</option>
                  <option>Brown / Tan</option>
                  <option>Yellow / Gold</option>
                  <option>Orange</option>
                  <option>Purple</option>
                  <option>Other</option>
                </select>
              </div>
              <div>
                <label for="vehicle-model">Make &amp; Model</label>
                <input type="text" id="vehicle-model" placeholder="e.g. Toyota Camry" maxlength="40" />
              </div>
            </div>
          </div>
        </div>

        <div class="section-block">
          <button class="rules-toggle" id="rules-toggle" type="button" aria-expanded="false">
            <span class="rules-toggle-left">Parking Rules &amp; Regulations</span>
            <span class="rules-toggle-right">
              <span id="rules-hint-text">View</span>
              <svg class="chevron" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
            </span>
          </button>
          <ul class="rules-list" id="rules-list">
            <li>This pass is valid for the date of purchase only. Non-transferable and non-refundable.</li>
            <li>All vehicles must be removed from the lot by <strong>3:00 AM</strong>.</li>
            <li>Overnight parking is strictly prohibited.</li>
            <li>No trailers, boats, or towed equipment of any kind permitted.</li>
            <li>Park within marked spaces only. Do not block driveways, fire lanes, or access points.</li>
            <li>LOZ Parking is not liable for theft, damage, or loss of any vehicle or its contents.</li>
            <li>Unpaid or non-compliant vehicles may be towed at the owner's expense without notice.</li>
          </ul>
          <label class="agree-row" for="agree">
            <input type="checkbox" id="agree" />
            <span>I have read and agree to the parking rules above.</span>
          </label>
        </div>

      </div>

      <!-- ── ORDER SUMMARY ── -->
      <div class="summary-side">
        <div class="summary-card">
          <div class="summary-card-head">Order Summary</div>

          <div class="summary-item">
            <div class="summary-item-name">LOZ Parking — Day Pass</div>
            <div class="summary-meta">
              <span>
                <svg width="11" height="11" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0L6.343 16.657a8 8 0 1111.314 0z"/><circle cx="12" cy="11" r="3" stroke-width="2"/></svg>
                1560 Bagnell Dam Blvd, Lake Ozark
              </span>
              <span>
                <svg width="11" height="11" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" stroke-width="2"/><path d="M16 2v4M8 2v4M3 10h18" stroke-width="2" stroke-linecap="round"/></svg>
                Valid today only
              </span>
              <span>
                <svg width="11" height="11" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Must exit by 3:00 AM
              </span>
            </div>
          </div>

          <div class="summary-lines">
            <div class="summary-line">
              <span>Day Pass × 1</span>
              <span>$20.00</span>
            </div>
            <div class="summary-line">
              <span>Fees</span>
              <span>$0.00</span>
            </div>
          </div>

          <div class="summary-total">
            <span class="summary-total-label">Total</span>
            <span class="summary-total-price">$20.00</span>
          </div>

          <div class="summary-cta">
            <div class="error-msg" id="error-msg"></div>
            <button class="pay-btn" id="pay-btn" type="button">
              <div class="spinner"></div>
              <span class="btn-text">Complete Purchase</span>
            </button>
            <p class="fine-print">
              <svg width="11" height="11" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" stroke-width="2"/><path d="M7 11V7a5 5 0 0110 0v4" stroke-width="2" stroke-linecap="round"/></svg>
              Secured by DonorKit · All sales final
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>

</body>
</html>

<script>
  const rulesToggle = document.getElementById('rules-toggle') as HTMLButtonElement;
  const rulesList = document.getElementById('rules-list')!;
  const rulesHintText = document.getElementById('rules-hint-text')!;

  rulesToggle.addEventListener('click', () => {
    const open = rulesList.classList.toggle('open');
    rulesToggle.classList.toggle('open', open);
    rulesToggle.setAttribute('aria-expanded', String(open));
    rulesHintText.textContent = open ? 'Hide' : 'View';
  });

  const plateInput = document.getElementById('plate') as HTMLInputElement;
  const errorMsg = document.getElementById('error-msg')!;
  const payBtn = document.getElementById('pay-btn') as HTMLButtonElement;
  const agreeCheckbox = document.getElementById('agree') as HTMLInputElement;

  plateInput.addEventListener('input', () => {
    plateInput.value = plateInput.value.toUpperCase().replace(/[^A-Z0-9 ]/g, '');
  });

  function showError(msg: string) {
    errorMsg.textContent = msg;
    errorMsg.classList.add('show');
    errorMsg.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function hideError() { errorMsg.classList.remove('show'); }

  payBtn.addEventListener('click', async () => {
    hideError();
    const plate = plateInput.value.trim();
    const state = (document.getElementById('state') as HTMLSelectElement).value;
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const agreed = agreeCheckbox.checked;
    const vehicleModel = (document.getElementById('vehicle-model') as HTMLInputElement).value.trim();
    const vehicleColor = (document.getElementById('vehicle-color') as HTMLSelectElement).value;

    if (!plate || plate.length < 2) return showError('Please enter your license plate number.');
    if (!email || !email.includes('@')) return showError('Please enter a valid email address.');
    if (!agreed) return showError('Please agree to the parking rules to continue.');

    payBtn.disabled = true;
    payBtn.classList.add('loading');

    try {
      const res = await fetch('https://api.locc.us/api/v2/donation', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          amount: 20,
          email,
          donationType: 'one-time',
          frequency: 'monthly',
          coverFees: false,
          note: `Parking: ${plate} (${state})${vehicleColor ? ' · ' + vehicleColor : ''}${vehicleModel ? ' · ' + vehicleModel : ''} · Day Pass`
        })
      });

      const data = await res.json();

      if (data.success && data.url) {
        window.location.href = data.url;
      } else {
        throw new Error(data.message || 'Could not create payment session.');
      }
    } catch (err: any) {
      showError(err.message || 'Something went wrong. Please try again.');
      payBtn.disabled = false;
      payBtn.classList.remove('loading');
    }
  });
</script>
