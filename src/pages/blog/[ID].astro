---
import Layout from '../../layouts/Layout.astro';
import type { GetStaticPaths } from 'astro';
import SharePost from '../../components/SharePost.astro';

// Prerender this page as static HTML even in server mode
export const prerender = true;

// Define the Props interface for better type safety
interface Props {
  post: {
    frontmatter: {
      id: number;
      title: string;
      date: string;
      image?: string;
      excerpt: string;
      author?: string;
      authorRole?: string;
      authorImage?: string;
      location?: string;
      readingTime?: number;
    };
    Content: any;
    rawContent: () => string;
  };
}

// Export the getStaticPaths function for dynamic routing
export const getStaticPaths = (async () => {
  const postsGlob = import.meta.glob('../../blogs/*.md', { eager: true });
  const posts = Object.values(postsGlob) as any[];

  return posts.map((post) => {
    // Calculate reading time based on word count
    const wordCount = post.rawContent().split(/\s+/).length;
    const readingTime = Math.ceil(wordCount / 200);

    return {
      params: { ID: post.frontmatter.id.toString() },
      props: {
        post: {
          frontmatter: {
            ...post.frontmatter,
            readingTime,
            authorImage: post.frontmatter.authorImage || 'https://upload.wikimedia.org/wikipedia/commons/9/99/Sample_User_Icon.png'
          },
          Content: post.Content,
          rawContent: post.rawContent,
        },
      },
    };
  });
}) satisfies GetStaticPaths;

// Get the post from props
const { post } = Astro.props;

// Guard against undefined post
if (!post || !post.Content) {
  return Astro.redirect('/404');
}

const { Content } = post;

// Format date helper function
function formatDate(dateStr: string): string {
  try {
    return new Date(dateStr).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
  } catch {
    return 'Date unavailable';
  }
}

// Navigation breadcrumbs
const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog' },
  { name: post.frontmatter.title, href: `/blog/${post.frontmatter.id}`, current: true },
];

const mailchimpSignupUrl = "https://lakeozarkdisciples.us7.list-manage.com/subscribe?u=9816d09f0ebdd5f8ce1af28b4&id=b26607b7c1";
---

<Layout title={post.frontmatter.title}>
  <!-- Hero Section - Matching index page style -->
  <section class="relative overflow-hidden bg-white">
    <div class="absolute inset-0">
      <img
        src={post.frontmatter.image || "https://usercontent.donorkit.io/clients/LOCC/6408A096-4585-4540-806B-66A6EB4027D7.jpeg"}
        alt={post.frontmatter.title}
        class="w-full h-full object-cover"
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-black/40"></div>
    </div>

    <div class="relative container mx-auto px-6 py-32 md:py-40">
      <div class="max-w-4xl">
        <!-- Breadcrumbs -->
        <nav class="mb-8">
          <div class="flex items-center space-x-2 text-white/80">
            {
              breadcrumbs.map((item, index) => (
                <div class="flex items-center">
                  {index > 0 && (
                    <svg
                      class="h-4 w-4 mx-2 text-white/60"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path d="M5.555 17.776l8-16 .894.448-8 16-.894-.448z" />
                    </svg>
                  )}
                  <a
                    href={item.href}
                    class:list={[
                      'text-sm font-medium hover:text-white transition-colors',
                      item.current
                        ? 'text-white cursor-default'
                        : 'text-white/80',
                    ]}
                    aria-current={item.current ? 'page' : undefined}
                  >
                    {item.name}
                  </a>
                </div>
              ))
            }
          </div>
        </nav>

        <!-- Post Meta -->
        <div class="flex flex-wrap items-center gap-4 text-white/90 mb-6 text-sm">
          <time datetime={new Date(post.frontmatter.date).toISOString()}>
            {formatDate(post.frontmatter.date)}
          </time>
          <span>·</span>
          <span>{post.frontmatter.readingTime} min read</span>
          {
            post.frontmatter.location && (
              <>
                <span>·</span>
                <span>{post.frontmatter.location}</span>
              </>
            )
          }
        </div>

        <!-- Title and Excerpt -->
        <h1 class="text-5xl md:text-7xl font-semibold text-white mb-8 leading-tight tracking-tight">
          {post.frontmatter.title}
        </h1>
        <p class="text-lg md:text-xl text-white/80 mb-12 max-w-2xl font-light leading-relaxed">
          {post.frontmatter.excerpt}
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4">
          <a 
            href="#post-content" 
            class="inline-flex items-center justify-center px-8 py-4 bg-brand hover:bg-brand-dark text-white font-medium rounded-lg transition-all duration-300 text-lg"
          >
            Read Post
          </a>
          <a 
            href={mailchimpSignupUrl} 
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-8 py-4 bg-transparent border-2 border-white text-white hover:bg-white hover:text-gray-900 font-medium rounded-lg transition-all duration-300 text-lg"
          >
            Subscribe to Updates
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <article id="post-content" class="py-20 bg-white">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <!-- Author Info Card -->
        <div class="bg-gray-50 rounded-xl p-6 mb-12 border border-gray-200">
          <div class="flex items-center gap-4">
            <img
              src={post.frontmatter.authorImage}
              alt={post.frontmatter.author || 'Author Image'}
              class="w-14 h-14 rounded-full object-cover ring-2 ring-white"
              onerror="this.src='https://upload.wikimedia.org/wikipedia/commons/9/99/Sample_User_Icon.png'"
            />
            <div>
              <div class="font-semibold text-gray-900 text-lg">
                {post.frontmatter.author || '[Unknown Author]'}
              </div>
              <div class="text-sm text-gray-600">
                {post.frontmatter.authorRole || '[Content Writer for LOCC]'}
              </div>
            </div>
          </div>
        </div>

        <!-- Post Body -->
        <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-600 prose-a:text-brand hover:prose-a:text-brand/80 prose-strong:text-gray-900 prose-code:text-gray-800 prose-img:rounded-lg prose-img:shadow-lg prose-img:my-8">
          <Content />
        </div>

        <!-- Share Section -->
        <div class="mt-16 pt-12 border-t border-gray-200">
          <SharePost title={post.frontmatter.title} postId={post.frontmatter.id} />
        </div>

        <!-- Back to Blog Link -->
        <div class="mt-12 text-center">
          <a 
            href="/blog" 
            class="inline-flex items-center gap-2 text-brand hover:text-brand-dark font-medium transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Back to All Posts
          </a>
        </div>
      </div>
    </div>
  </article>
</Layout>

<style is:global>
  /* Custom image styles */
  .prose img {
    @apply mx-auto my-8 rounded-lg shadow-lg;
  }

  /* Support for image dimensions */
  .prose img[width] {
    @apply w-auto h-auto;
  }

  /* Support for image alignment */
  .prose img[align="left"] {
    @apply float-left mr-8;
  }

  .prose img[align="right"] {
    @apply float-right ml-8;
  }

  .prose img[align="center"] {
    @apply mx-auto;
  }

  /* Figure styles */
  .prose figure {
    @apply my-8;
  }

  .prose figure img {
    @apply my-0;
  }

  .prose figcaption {
    @apply text-center text-gray-500 mt-2 text-sm;
  }

  /* Link styles */
  .prose a {
    @apply transition-colors duration-200 text-brand hover:text-brand/80;
  }

  /* List styles - Disabled */
  .prose ul, .prose ol {
    @apply hidden;
  }

  /* Code block styles */
  .prose pre {
    @apply bg-gray-50 border border-gray-200 shadow-sm;
  }

  .prose code {
    @apply bg-gray-50 px-1 py-0.5 rounded text-sm;
  }

  /* Blockquote styles */
  .prose blockquote {
    @apply border-l-4 border-brand bg-gray-50 py-2 px-4 italic;
  }

  /* Table styles */
  .prose table {
    @apply border-collapse border border-gray-200;
  }

  .prose th {
    @apply bg-gray-50 px-4 py-2 border border-gray-200;
  }

  .prose td {
    @apply px-4 py-2 border border-gray-200;
  }

  /* Heading styles */
  .prose h1 {
    @apply text-4xl font-bold mb-6;
  }

  .prose h2 {
    @apply text-3xl font-semibold mb-4;
  }
</style>
