---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Thank You">
  <section class="min-h-[60vh] flex flex-col justify-center items-center text-center py-24">
    <h2 class="text-2xl font-semibold text-gray-800 mb-2">Your donation has been processed successfully</h2>
    <p class="text-gray-600 mb-6 max-w-xl">
      Your generous contribution helps us continue our ministry and outreach efforts in the Lake Ozark community. A recept is on its way to your email address.
    </p>
    <div class="flex flex-col sm:flex-row gap-4">
      <a href="https://billing.stripe.com/p/login/14k15102u3dA1H2144" target="_blank" rel="noopener noreferrer" class="inline-block px-6 py-3 bg-brand text-white rounded-lg hover:bg-brand-dark transition">
        Manage Donation
      </a>
      <a href="/" class="inline-block px-6 py-3 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 transition">
        Go Home
      </a>
    </div>
  </section>
</Layout>
